{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore: подготовить релиз ${version}",
  "pull-request-header": "Этот PR готовит новый релиз Wave Shell. Проверьте версию и CHANGELOG перед слиянием: после слияния соберутся установщики для macOS, Windows и Linux, и релиз опубликуется сам.",
  "changelog-sections": [
    { "type": "feat", "section": "Добавлено" },
    { "type": "fix", "section": "Исправлено" },
    { "type": "perf", "section": "Производительность" },
    { "type": "update", "section": "Изменено" },
    { "type": "delete", "section": "Удалено" },
    { "type": "upstream", "section": "Из iBC Shell" },
    { "type": "refactor", "section": "Внутренние изменения" },
    { "type": "docs", "section": "Документация" },
    { "type": "test", "section": "Тесты" },
    { "type": "build", "section": "Сборка и зависимости" },
    { "type": "ci", "section": "CI и релизы" },
    { "type": "chore", "section": "Обслуживание", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "wave-shell",
      "extra-files": [
        { "type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ui/package.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(!@.source)].version" }
      ]
    }
  }
}
